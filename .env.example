# Copy this file to .env and fill in the values. Never commit .env.

# From developer.paypal.com -> Apps & Credentials -> (Sandbox) -> your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Filled in after you create the webhook (step 6 in the README)
PAYPAL_WEBHOOK_ID=

# Email of your sandbox PERSONAL (buyer) account. Every invoice is sent here in the demo.
FORCE_RECIPIENT_EMAIL=

# Local testing only. Never set to true on Render.
SKIP_WEBHOOK_VERIFY=false

DATABASE_PATH=quoteloop.db
